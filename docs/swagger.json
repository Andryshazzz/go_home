{
    "swagger": "2.0",
    "info": {
        "description": "User service API.",
        "title": "go_home API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/auth/register": {
            "post": {
                "description": "Creates a user and returns an access/refresh token pair.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Registration data",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go_home_internal_domain_dto.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/go_home_internal_domain_dto.RegisterResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/go_home_internal_domain_dto.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/go_home_internal_domain_dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/go_home_internal_domain_dto.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "go_home_internal_domain_dto.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid request"
                },
                "message": {
                    "type": "string",
                    "example": "Key: 'RegisterRequest.Email' Error:Field validation for 'Email' failed on the 'email' tag"
                }
            }
        },
        "go_home_internal_domain_dto.RegisterRequest": {
            "type": "object",
            "required": [
                "age",
                "email",
                "login",
                "password"
            ],
            "properties": {
                "age": {
                    "type": "integer",
                    "example": 25
                },
                "bio": {
                    "type": "string",
                    "maxLength": 1000,
                    "example": "Hello, I am Ivan"
                },
                "email": {
                    "type": "string",
                    "example": "ivan@example.com"
                },
                "login": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3,
                    "example": "ivan"
                },
                "password": {
                    "type": "string",
                    "minLength": 8,
                    "example": "Str0ngPass!"
                }
            }
        },
        "go_home_internal_domain_dto.RegisterResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                },
                "refresh_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                }
            }
        }
    }
}