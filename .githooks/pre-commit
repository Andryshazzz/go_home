set -euo pipefail

if ! command -v golangci-lint >/dev/null 2>&1; then
  echo "pre-commit: golangci-lint is not installed (see README, section Linting)." >&2
  exit 1
fi

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.go$|^go\.(mod|sum)$|^\.golangci\.yml$'; then
  exit 0
fi

echo "pre-commit: running golangci-lint..."
if ! golangci-lint run ./...; then
  echo >&2
  echo "pre-commit: lint failed. Fix the issues (try: make lint-fix) or skip once with git commit --no-verify." >&2
  exit 1
fi